ADMIN_ORIGIN=https://admin.scholarscafe.com
PUBLIC_ORIGIN=https://scholarscafe.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASSWORD=
PORT=3000
# Mailbox that sends sign-in codes and notifications (default contact@scholarscafe.com).
# Switch to no-reply@scholarscafe.com once that mailbox exists in hPanel.
# SMTP_USER=no-reply@scholarscafe.com
# That mailbox's password. Never commit the real value.
SMTP_PASSWORD=
# Set only after Hostinger confirms the trusted reverse-proxy addresses.
# TRUST_PROXY=127.0.0.1/8,::1/128
# Optional: Cloudflare Turnstile bot check on public forms (free). Leave empty to disable.
TURNSTILE_SECRET_KEY=
# Only used on a brand-new empty database: the first Super Admin. Default contact.scholarscafe@gmail.com
# (OWNER_EMAIL still works as the old name.)
# SUPER_ADMIN_EMAIL=
# Student portal deployment only (student.scholarscafe.com). Leave both unset on the admin app.
# PORTAL=student
# STUDENT_ORIGIN=https://student.scholarscafe.com
